{
  "$schema": "node_modules/wrangler/config-schema.json",
  // bare Ops: inventory and GST billing for bare Skinscience (Bare Origin Pvt Ltd).
  // A separate Worker from the marketing site, so the website's Pages project is untouched.
  // The top level is PRODUCTION; local development uses `--env dev` (see package.json).
  "name": "bare-ops",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // No database_id: the first deploy (from GitHub or `wrangler deploy`) creates the database in the account
  // and links it. The app creates its own tables on first start (src/migrate.ts).
  "d1_databases": [{ "binding": "DB", "database_name": "bare-ops" }],
  // Migration files are bundled into the Worker as text.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true },
  // Served at ops.bareskinscience.in, attached in the dashboard (bare-ops > Domains > Add Domain). It isn't listed
  // here, so deploys never need the build token to have DNS rights on the bareskinscience.in zone, and leave the
  // domain as it is. The workers.dev address is off: the app is reachable only on its own domain.
  "workers_dev": false,
  "keep_vars": true,
  "vars": { "APP_ENV": "production" },

  "env": {
    "dev": {
      "d1_databases": [{ "binding": "DB", "database_name": "bare-ops-dev" }],
      "routes": [],
      "vars": { "APP_ENV": "development" }
    }
  }
}
